{
  "name": "retail-pos",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "overrides": {
    "@hono/node-server": "1.19.13",
    "postcss": "8.5.20"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "postinstall": "prisma generate",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:auth": "vitest run src/features/auth",
    "test:db": "vitest run src/features/auth/authentication.database.test.ts src/features/users/administration.database.test.ts src/features/products/catalog.database.test.ts src/features/purchases/purchases.database.test.ts src/features/inventory/inventory.database.test.ts",
    "test:catalog": "vitest run src/features/products",
    "test:purchases": "vitest run src/features/purchases",
    "test:inventory": "vitest run src/features/inventory",
    "test:users": "vitest run src/features/users",
    "test:watch": "vitest",
    "prisma:generate": "prisma generate",
    "prisma:format": "prisma format",
    "prisma:validate": "prisma validate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "check": "npm run prisma:validate && npm run lint && npm run typecheck && npm run test"
  },
  "dependencies": {
    "@hookform/resolvers": "5.4.0",
    "@node-rs/argon2": "2.0.2",
    "@prisma/adapter-pg": "7.8.0",
    "@prisma/client": "7.8.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "dotenv": "^17.4.2",
    "lucide-react": "1.25.0",
    "next": "^16.3.0",
    "pg": "8.22.0",
    "radix-ui": "1.6.4",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-hook-form": "7.82.0",
    "recharts": "^3.10.0",
    "sonner": "2.0.7",
    "tailwind-merge": "3.6.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@ts-morph/common": "^0.29.0",
    "@types/node": "^26.1.1",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.2.10",
    "prettier": "^3.9.5",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "prisma": "^7.9.0",
    "shadcn": "^4.13.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  }
}
