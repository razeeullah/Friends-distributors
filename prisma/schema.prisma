generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  ACTIVE
  DISABLED
  INVITED
  ARCHIVED
}

enum StockMovementType {
  PURCHASE
  SALE
  CUSTOMER_RETURN
  SUPPLIER_RETURN
  ADJUSTMENT_IN
  ADJUSTMENT_OUT
  TRANSFER_IN
  TRANSFER_OUT
  OPENING_STOCK
  VOID_REVERSAL
}

enum StockReferenceType {
  PURCHASE
  SALE
  SALE_RETURN
  SUPPLIER_RETURN
  STOCK_ADJUSTMENT
  STOCK_TRANSFER
  OPENING_STOCK
  SALE_VOID
}

enum PurchaseStatus {
  DRAFT
  ORDERED
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

enum SupplierReturnStatus {
  DRAFT
  COMPLETED
  VOIDED
}

enum AdjustmentType {
  INCREASE
  DECREASE
  STOCKTAKE
}

enum StockAdjustmentStatus {
  DRAFT
  COMPLETED
  VOIDED
}

enum TransferStatus {
  DRAFT
  IN_TRANSIT
  COMPLETED
  CANCELLED
}

enum SaleStatus {
  DRAFT
  HELD
  COMPLETED
  VOIDED
  REFUNDED
}

enum SaleReturnStatus {
  DRAFT
  COMPLETED
  VOIDED
}

enum PaymentMethod {
  CASH
  CARD
  BANK_TRANSFER
  MOBILE_WALLET
  CREDIT
  MIXED
  STORE_CREDIT
  OTHER
}

enum ProductPriceType {
  RETAIL
  WHOLESALE
  PROMOTION
}

enum ExpenseStatus {
  DRAFT
  PENDING
  PENDING_APPROVAL
  APPROVED
  REJECTED
  PAID
  VOIDED
}

enum RegisterSessionStatus {
  OPEN
  CLOSED
}

enum CashMovementType {
  CASH_IN
  CASH_OUT
  SALE
  REFUND
  EXPENSE
}

enum AuditAction {
  CREATE
  UPDATE
  ARCHIVE
  VOID
  REFUND
  APPROVE
  AUTH_LOGIN_BLOCKED
  AUTH_ACCOUNT_LOCKED
  AUTH_LOGIN_FAILED
  AUTH_LOGIN_SUCCEEDED
  AUTH_LOGOUT
  AUTH_PASSWORD_CHANGED
  USER_CREATED
  USER_UPDATED
  USER_DISABLED
  USER_PASSWORD_RESET
  ROLE_CREATED
  ROLE_UPDATED
  ROLE_PERMISSIONS_CHANGED
  SESSION_REVOKED
  SYSTEM_SEEDED
  PURCHASE_CANCELLED
  PURCHASE_PAYMENT_RECORDED
  PURCHASE_RECEIVED
  INVENTORY_ADJUSTED
  STOCK_TRANSFERRED
  SALE_COMPLETED
  SALE_HELD
  SALE_PRICE_OVERRIDDEN
  SALE_LARGE_DISCOUNT
  SALE_RETURNED
  SALE_VOIDED
  REGISTER_OPENED
  REGISTER_CASH_ADDED
  REGISTER_CASH_REMOVED
  REGISTER_CLOSED
  REGISTER_DIFFERENCE_RECORDED
  EXPENSE_CREATED
  EXPENSE_SUBMITTED
  EXPENSE_APPROVED
  EXPENSE_REJECTED
  EXPENSE_PAID
  EXPENSE_VOIDED
}

enum LoginFailureReason {
  INVALID_CREDENTIALS
  USER_DISABLED
  USER_LOCKED
  SESSION_EXPIRED
}

model Business {
  id                    String             @id @default(uuid()) @db.Uuid
  slug                  String             @unique @db.VarChar(100)
  name                  String             @db.VarChar(160)
  legalName             String?            @db.VarChar(200)
  taxRegistrationNumber String?            @db.VarChar(80)
  currencyCode          String             @default("PKR") @db.Char(3)
  timezone              String             @default("Asia/Karachi") @db.VarChar(80)
  locale                String             @default("en-PK") @db.VarChar(20)
  createdAt             DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime           @updatedAt @db.Timestamptz(3)
  archivedAt            DateTime?          @db.Timestamptz(3)
  settings              BusinessSetting[]
  locations             Location[]
  registers             Register[]
  users                 User[]
  sessions              Session[]
  roles                 Role[]
  permissions           Permission[]
  userRoles             UserRole[]
  rolePermissions       RolePermission[]
  userLocations         UserLocation[]
  categories            Category[]
  brands                Brand[]
  units                 Unit[]
  products              Product[]
  productVariants       ProductVariant[]
  productBarcodes       ProductBarcode[]
  productPrices         ProductPrice[]
  suppliers             Supplier[]
  customers             Customer[]
  purchases             Purchase[]
  purchasePayments      PurchasePayment[]
  supplierReturns       SupplierReturn[]
  inventoryBalances     InventoryBalance[]
  stockMovements        StockMovement[]
  stockAdjustments      StockAdjustment[]
  stockTransfers        StockTransfer[]
  sales                 Sale[]
  salePayments          SalePayment[]
  saleReturns           SaleReturn[]
  expenseCategories     ExpenseCategory[]
  expenses              Expense[]
  registerSessions      RegisterSession[]
  cashMovements         CashMovement[]
  auditLogs             AuditLog[]
  numberSequences       NumberSequence[]
  loginAttempts         LoginAttempt[]

  @@map("businesses")
}

model BusinessSetting {
  id         String   @id @default(uuid()) @db.Uuid
  businessId String   @db.Uuid
  key        String   @db.VarChar(100)
  value      Json
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @db.Timestamptz(3)
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, key])
  @@index([businessId])
  @@map("business_settings")
}

model Location {
  id                  String             @id @default(uuid()) @db.Uuid
  businessId          String             @db.Uuid
  code                String             @db.VarChar(32)
  name                String             @db.VarChar(160)
  addressLine1        String?            @db.VarChar(200)
  addressLine2        String?            @db.VarChar(200)
  city                String?            @db.VarChar(100)
  province            String?            @db.VarChar(100)
  postalCode          String?            @db.VarChar(20)
  phone               String?            @db.VarChar(32)
  isActive            Boolean            @default(true)
  createdAt           DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime           @updatedAt @db.Timestamptz(3)
  archivedAt          DateTime?          @db.Timestamptz(3)
  business            Business           @relation(fields: [businessId], references: [id], onDelete: Restrict)
  registers           Register[]
  userLocations       UserLocation[]
  productPrices       ProductPrice[]
  purchases           Purchase[]
  supplierReturns     SupplierReturn[]
  inventoryBalances   InventoryBalance[]
  stockMovements      StockMovement[]
  stockAdjustments    StockAdjustment[]
  outgoingTransfers   StockTransfer[]    @relation("TransferFromLocation")
  incomingTransfers   StockTransfer[]    @relation("TransferToLocation")
  sales               Sale[]
  saleReturns         SaleReturn[]
  expenses            Expense[]
  registerSessions    RegisterSession[]
  cashMovements       CashMovement[]
  auditLogs           AuditLog[]
  numberSequences     NumberSequence[]
  currentUserSessions Session[]          @relation("SessionCurrentLocation")
  defaultUsers        User[]             @relation("UserDefaultLocation")

  @@unique([businessId, code])
  @@index([businessId, isActive])
  @@map("locations")
}

model Register {
  id         String            @id @default(uuid()) @db.Uuid
  businessId String            @db.Uuid
  locationId String            @db.Uuid
  code       String            @db.VarChar(40)
  name       String            @db.VarChar(120)
  isActive   Boolean           @default(true)
  createdAt  DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime          @updatedAt @db.Timestamptz(3)
  archivedAt DateTime?         @db.Timestamptz(3)
  business   Business          @relation(fields: [businessId], references: [id], onDelete: Restrict)
  location   Location          @relation(fields: [locationId], references: [id], onDelete: Restrict)
  sessions   RegisterSession[]
  sales      Sale[]

  @@unique([businessId, code])
  @@index([locationId, isActive])
  @@map("cash_registers")
}

model User {
  id                      String            @id @default(uuid()) @db.Uuid
  businessId              String            @db.Uuid
  defaultLocationId       String?           @db.Uuid
  email                   String            @unique @db.VarChar(254)
  username                String            @unique @db.VarChar(64)
  displayName             String            @db.VarChar(160)
  phone                   String?           @db.VarChar(32)
  passwordHash            String            @db.VarChar(255)
  status                  UserStatus        @default(ACTIVE)
  failedLoginAttempts     Int               @default(0)
  lockedUntil             DateTime?         @db.Timestamptz(3)
  lastLoginAt             DateTime?         @db.Timestamptz(3)
  createdAt               DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt               DateTime          @updatedAt @db.Timestamptz(3)
  archivedAt              DateTime?         @db.Timestamptz(3)
  business                Business          @relation(fields: [businessId], references: [id], onDelete: Restrict)
  defaultLocation         Location?         @relation("UserDefaultLocation", fields: [defaultLocationId], references: [id], onDelete: SetNull)
  roles                   UserRole[]
  locations               UserLocation[]
  sessions                Session[]
  loginAttempts           LoginAttempt[]
  purchasesCreated        Purchase[]        @relation("PurchaseCreatedBy")
  purchasesReceived       Purchase[]        @relation("PurchaseReceivedBy")
  purchasePaymentsCreated PurchasePayment[] @relation("PurchasePaymentCreatedBy")
  supplierReturnsCreated  SupplierReturn[]  @relation("SupplierReturnCreatedBy")
  stockMovements          StockMovement[]   @relation("StockMovementPerformedBy")
  adjustmentsCreated      StockAdjustment[] @relation("StockAdjustmentCreatedBy")
  adjustmentsCompleted    StockAdjustment[] @relation("StockAdjustmentCompletedBy")
  transfersCreated        StockTransfer[]   @relation("StockTransferCreatedBy")
  transfersCompleted      StockTransfer[]   @relation("StockTransferCompletedBy")
  salesCreated            Sale[]            @relation("SaleCashier")
  salesVoided             Sale[]            @relation("SaleVoidedBy")
  salePaymentsReceived    SalePayment[]     @relation("SalePaymentReceivedBy")
  saleReturnsProcessed    SaleReturn[]      @relation("SaleReturnProcessedBy")
  expensesCreated         Expense[]         @relation("ExpenseCreatedBy")
  expensesApproved        Expense[]         @relation("ExpenseApprovedBy")
  expensesPaid            Expense[]         @relation("ExpensePaidBy")
  expensesVoided          Expense[]         @relation("ExpenseVoidedBy")
  categoriesCreated       Category[]        @relation("CategoryCreatedBy")
  categoriesUpdated       Category[]        @relation("CategoryUpdatedBy")
  registerSessionsOpened  RegisterSession[] @relation("RegisterSessionOpenedBy")
  registerSessionsClosed  RegisterSession[] @relation("RegisterSessionClosedBy")
  cashMovementsCreated    CashMovement[]    @relation("CashMovementCreatedBy")
  auditLogs               AuditLog[]        @relation("AuditActor")

  @@unique([businessId, email])
  @@unique([businessId, username])
  @@index([businessId, status])
  @@index([defaultLocationId])
  @@index([email])
  @@index([lockedUntil])
  @@map("users")
}

model Session {
  id                String    @id @default(uuid()) @db.Uuid
  businessId        String    @db.Uuid
  userId            String    @db.Uuid
  currentLocationId String?   @db.Uuid
  tokenHash         String    @unique @db.Char(64)
  rememberMe        Boolean   @default(false)
  expiresAt         DateTime  @db.Timestamptz(3)
  lastSeenAt        DateTime  @default(now()) @db.Timestamptz(3)
  ipAddress         String?   @db.VarChar(64)
  userAgent         String?   @db.VarChar(500)
  revokedAt         DateTime? @db.Timestamptz(3)
  createdAt         DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime  @updatedAt @db.Timestamptz(3)
  business          Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  currentLocation   Location? @relation("SessionCurrentLocation", fields: [currentLocationId], references: [id], onDelete: SetNull)

  @@index([businessId, expiresAt])
  @@index([userId, expiresAt])
  @@index([currentLocationId])
  @@index([expiresAt, revokedAt])
  @@map("sessions")
}

model Role {
  id          String           @id @default(uuid()) @db.Uuid
  businessId  String           @db.Uuid
  code        String           @db.VarChar(64)
  name        String           @db.VarChar(100)
  description String?          @db.VarChar(240)
  isSystem    Boolean          @default(false)
  createdAt   DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime         @updatedAt @db.Timestamptz(3)
  archivedAt  DateTime?        @db.Timestamptz(3)
  business    Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  users       UserRole[]
  permissions RolePermission[]

  @@unique([businessId, code])
  @@index([businessId])
  @@map("roles")
}

model Permission {
  id          String           @id @default(uuid()) @db.Uuid
  businessId  String           @db.Uuid
  key         String           @db.VarChar(100)
  description String?          @db.VarChar(240)
  createdAt   DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime         @updatedAt @db.Timestamptz(3)
  business    Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  roles       RolePermission[]

  @@unique([businessId, key])
  @@index([businessId])
  @@map("permissions")
}

model UserRole {
  businessId String   @db.Uuid
  userId     String   @db.Uuid
  roleId     String   @db.Uuid
  assignedAt DateTime @default(now()) @db.Timestamptz(3)
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role       Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([businessId, userId, roleId])
  @@unique([userId, roleId])
  @@index([roleId])
  @@map("user_roles")
}

model RolePermission {
  businessId   String     @db.Uuid
  roleId       String     @db.Uuid
  permissionId String     @db.Uuid
  business     Business   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([businessId, roleId, permissionId])
  @@unique([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

model UserLocation {
  businessId String   @db.Uuid
  userId     String   @db.Uuid
  locationId String   @db.Uuid
  assignedAt DateTime @default(now()) @db.Timestamptz(3)
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  location   Location @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@id([businessId, userId, locationId])
  @@unique([userId, locationId])
  @@index([locationId])
  @@map("user_locations")
}

model LoginAttempt {
  id              String              @id @default(uuid()) @db.Uuid
  businessId      String?             @db.Uuid
  userId          String?             @db.Uuid
  emailNormalized String              @db.VarChar(254)
  ipAddress       String?             @db.VarChar(64)
  userAgent       String?             @db.VarChar(500)
  succeeded       Boolean
  failureReason   LoginFailureReason?
  createdAt       DateTime            @default(now()) @db.Timestamptz(3)
  business        Business?           @relation(fields: [businessId], references: [id], onDelete: SetNull)
  user            User?               @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([emailNormalized, createdAt])
  @@index([ipAddress, createdAt])
  @@index([userId, createdAt])
  @@map("login_attempts")
}

model Category {
  id           String     @id @default(uuid()) @db.Uuid
  businessId   String     @db.Uuid
  parentId     String?    @db.Uuid
  name         String     @db.VarChar(120)
  slug         String     @db.VarChar(140)
  description  String?    @db.VarChar(500)
  imageUrl     String?    @db.VarChar(2048)
  displayOrder Int        @default(0)
  isActive     Boolean    @default(true)
  createdById  String?    @db.Uuid
  updatedById  String?    @db.Uuid
  createdAt    DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime   @updatedAt @db.Timestamptz(3)
  archivedAt   DateTime?  @db.Timestamptz(3)
  business     Business   @relation(fields: [businessId], references: [id], onDelete: Restrict)
  parent       Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: Restrict)
  children     Category[] @relation("CategoryHierarchy")
  createdBy    User?      @relation("CategoryCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy    User?      @relation("CategoryUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  products     Product[]

  @@unique([businessId, slug])
  @@index([businessId, isActive])
  @@index([businessId, parentId, name])
  @@index([parentId])
  @@index([businessId, displayOrder])
  @@map("categories")
}

model Brand {
  id          String    @id @default(uuid()) @db.Uuid
  businessId  String    @db.Uuid
  name        String    @db.VarChar(120)
  slug        String    @db.VarChar(140)
  description String?   @db.VarChar(500)
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @db.Timestamptz(3)
  archivedAt  DateTime? @db.Timestamptz(3)
  business    Business  @relation(fields: [businessId], references: [id], onDelete: Restrict)
  products    Product[]

  @@unique([businessId, slug])
  @@index([businessId, isActive])
  @@map("brands")
}

model Unit {
  id           String    @id @default(uuid()) @db.Uuid
  businessId   String    @db.Uuid
  name         String    @db.VarChar(80)
  abbreviation String    @db.VarChar(16)
  precision    Int       @default(0)
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime  @updatedAt @db.Timestamptz(3)
  archivedAt   DateTime? @db.Timestamptz(3)
  business     Business  @relation(fields: [businessId], references: [id], onDelete: Restrict)
  products     Product[]

  @@unique([businessId, abbreviation])
  @@index([businessId, isActive])
  @@map("units")
}

model Product {
  id                 String           @id @default(uuid()) @db.Uuid
  businessId         String           @db.Uuid
  categoryId         String           @db.Uuid
  brandId            String?          @db.Uuid
  unitId             String           @db.Uuid
  name               String           @db.VarChar(180)
  slug               String           @db.VarChar(200)
  description        String?          @db.Text
  sku                String           @db.VarChar(80)
  taxable            Boolean          @default(true)
  taxRate            Decimal          @default(0) @db.Decimal(7, 4)
  taxInclusive       Boolean          @default(false)
  trackInventory     Boolean          @default(true)
  allowNegativeStock Boolean          @default(false)
  minimumStock       Decimal          @default(0) @db.Decimal(20, 4)
  isActive           Boolean          @default(true)
  createdAt          DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime         @updatedAt @db.Timestamptz(3)
  archivedAt         DateTime?        @db.Timestamptz(3)
  business           Business         @relation(fields: [businessId], references: [id], onDelete: Restrict)
  category           Category         @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  brand              Brand?           @relation(fields: [brandId], references: [id], onDelete: SetNull)
  unit               Unit             @relation(fields: [unitId], references: [id], onDelete: Restrict)
  variants           ProductVariant[]
  saleItems          SaleItem[]

  @@unique([businessId, slug])
  @@unique([businessId, sku])
  @@index([businessId, isActive])
  @@index([businessId, archivedAt])
  @@index([businessId, name])
  @@index([categoryId])
  @@index([brandId])
  @@map("products")
}

model ProductVariant {
  id                   String                @id @default(uuid()) @db.Uuid
  businessId           String                @db.Uuid
  productId            String                @db.Uuid
  sku                  String                @db.VarChar(80)
  name                 String                @db.VarChar(160)
  size                 String?               @db.VarChar(80)
  color                String?               @db.VarChar(80)
  attributes           Json?
  costPrice            Decimal               @default(0) @db.Decimal(20, 2)
  sellingPrice         Decimal               @default(0) @db.Decimal(20, 2)
  minimumStock         Decimal               @default(0) @db.Decimal(20, 4)
  isActive             Boolean               @default(true)
  createdAt            DateTime              @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime              @updatedAt @db.Timestamptz(3)
  archivedAt           DateTime?             @db.Timestamptz(3)
  business             Business              @relation(fields: [businessId], references: [id], onDelete: Restrict)
  product              Product               @relation(fields: [productId], references: [id], onDelete: Restrict)
  barcodes             ProductBarcode[]
  prices               ProductPrice[]
  purchaseItems        PurchaseItem[]
  supplierReturnItems  SupplierReturnItem[]
  inventoryBalances    InventoryBalance[]
  stockMovements       StockMovement[]
  stockAdjustmentItems StockAdjustmentItem[]
  stockTransferItems   StockTransferItem[]
  saleItems            SaleItem[]

  @@unique([businessId, sku])
  @@index([productId, isActive])
  @@map("product_variants")
}

model ProductBarcode {
  id               String         @id @default(uuid()) @db.Uuid
  businessId       String         @db.Uuid
  productVariantId String         @db.Uuid
  barcode          String         @db.VarChar(100)
  isPrimary        Boolean        @default(false)
  createdAt        DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime       @updatedAt @db.Timestamptz(3)
  business         Business       @relation(fields: [businessId], references: [id], onDelete: Restrict)
  productVariant   ProductVariant @relation(fields: [productVariantId], references: [id], onDelete: Cascade)

  @@unique([businessId, barcode])
  @@unique([productVariantId, barcode])
  @@index([productVariantId, isPrimary])
  @@map("product_barcodes")
}

model ProductPrice {
  id               String           @id @default(uuid()) @db.Uuid
  businessId       String           @db.Uuid
  locationId       String?          @db.Uuid
  productVariantId String           @db.Uuid
  priceType        ProductPriceType @default(RETAIL)
  amount           Decimal          @db.Decimal(20, 2)
  startsAt         DateTime?        @db.Timestamptz(3)
  endsAt           DateTime?        @db.Timestamptz(3)
  isActive         Boolean          @default(true)
  createdAt        DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime         @updatedAt @db.Timestamptz(3)
  business         Business         @relation(fields: [businessId], references: [id], onDelete: Restrict)
  location         Location?        @relation(fields: [locationId], references: [id], onDelete: Cascade)
  productVariant   ProductVariant   @relation(fields: [productVariantId], references: [id], onDelete: Cascade)

  @@index([businessId, productVariantId, priceType, isActive])
  @@index([locationId, productVariantId, isActive])
  @@map("product_prices")
}

model Supplier {
  id                    String           @id @default(uuid()) @db.Uuid
  businessId            String           @db.Uuid
  code                  String           @db.VarChar(40)
  name                  String           @db.VarChar(180)
  contactName           String?          @db.VarChar(160)
  email                 String?          @db.VarChar(254)
  phone                 String?          @db.VarChar(32)
  address               String?          @db.Text
  taxRegistrationNumber String?          @db.VarChar(80)
  paymentTermsDays      Int              @default(0)
  openingBalance        Decimal          @default(0) @db.Decimal(20, 2)
  isActive              Boolean          @default(true)
  createdAt             DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime         @updatedAt @db.Timestamptz(3)
  archivedAt            DateTime?        @db.Timestamptz(3)
  business              Business         @relation(fields: [businessId], references: [id], onDelete: Restrict)
  purchases             Purchase[]
  returns               SupplierReturn[]

  @@unique([businessId, code])
  @@index([businessId, isActive])
  @@index([businessId, name])
  @@map("suppliers")
}

model Customer {
  id         String    @id @default(uuid()) @db.Uuid
  businessId String    @db.Uuid
  code       String    @db.VarChar(40)
  name       String    @db.VarChar(180)
  email      String?   @db.VarChar(254)
  phone      String?   @db.VarChar(32)
  address    String?   @db.Text
  notes      String?   @db.Text
  isActive   Boolean   @default(true)
