  description String?   @db.VarChar(300)
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @db.Timestamptz(3)
  archivedAt  DateTime? @db.Timestamptz(3)
  business    Business  @relation(fields: [businessId], references: [id], onDelete: Restrict)
  expenses    Expense[]

  @@unique([businessId, code])
  @@index([businessId, isActive])
  @@map("expense_categories")
}

model Expense {
  id                String           @id @default(uuid()) @db.Uuid
  businessId        String           @db.Uuid
  locationId        String           @db.Uuid
  expenseCategoryId String           @db.Uuid
  registerSessionId String?          @db.Uuid
  expenseNumber     String           @db.VarChar(64)
  status            ExpenseStatus    @default(PENDING)
  expenseDate       DateTime         @db.Date
  vendorName        String?          @db.VarChar(180)
  description       String           @db.VarChar(500)
  amount            Decimal          @db.Decimal(20, 2)
  tax               Decimal          @default(0) @db.Decimal(20, 2)
  total             Decimal          @db.Decimal(20, 2)
  receiptReference  String?          @db.VarChar(300)
  paymentMethod     PaymentMethod?
  paidAt            DateTime?        @db.Timestamptz(3)
  paidById          String?          @db.Uuid
  voidedAt          DateTime?        @db.Timestamptz(3)
  voidedById        String?          @db.Uuid
  voidReason        String?          @db.VarChar(500)
  createdById       String           @db.Uuid
  approvedById      String?          @db.Uuid
  approvedAt        DateTime?        @db.Timestamptz(3)
  createdAt         DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime         @updatedAt @db.Timestamptz(3)
  archivedAt        DateTime?        @db.Timestamptz(3)
  business          Business         @relation(fields: [businessId], references: [id], onDelete: Restrict)
  location          Location         @relation(fields: [locationId], references: [id], onDelete: Restrict)
  expenseCategory   ExpenseCategory  @relation(fields: [expenseCategoryId], references: [id], onDelete: Restrict)
  registerSession   RegisterSession? @relation(fields: [registerSessionId], references: [id], onDelete: Restrict)
  createdBy         User             @relation("ExpenseCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  approvedBy        User?            @relation("ExpenseApprovedBy", fields: [approvedById], references: [id], onDelete: Restrict)
  paidBy            User?            @relation("ExpensePaidBy", fields: [paidById], references: [id], onDelete: Restrict)
  voidedBy          User?            @relation("ExpenseVoidedBy", fields: [voidedById], references: [id], onDelete: Restrict)

  @@unique([businessId, expenseNumber])
  @@index([businessId, status, expenseDate])
  @@index([locationId, expenseDate])
  @@index([expenseCategoryId, expenseDate])
  @@map("expenses")
}

model AuditLog {
  id          String      @id @default(uuid()) @db.Uuid
  businessId  String      @db.Uuid
  locationId  String?     @db.Uuid
  actorUserId String?     @db.Uuid
  action      AuditAction
  entityType  String      @db.VarChar(120)
  entityId    String?     @db.VarChar(100)
  summary     String?     @db.VarChar(500)
  requestId   String?     @db.Uuid
  before      Json?
  after       Json?
  metadata    Json?
  ipAddress   String?     @db.VarChar(64)
  userAgent   String?     @db.VarChar(500)
  createdAt   DateTime    @default(now()) @db.Timestamptz(3)
  business    Business    @relation(fields: [businessId], references: [id], onDelete: Restrict)
  location    Location?   @relation(fields: [locationId], references: [id], onDelete: Restrict)
  actor       User?       @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([businessId, createdAt])
  @@index([entityType, entityId, createdAt])
  @@index([actorUserId, createdAt])
  @@index([action, createdAt])
  @@index([businessId, requestId])
  @@map("audit_logs")
}

model NumberSequence {
  id         String    @id @default(uuid()) @db.Uuid
  businessId String    @db.Uuid
  locationId String?   @db.Uuid
  key        String    @db.VarChar(80)
  prefix     String    @default("") @db.VarChar(32)
  nextValue  BigInt    @default(1)
  padding    Int       @default(6)
  createdAt  DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime  @updatedAt @db.Timestamptz(3)
  business   Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  location   Location? @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@unique([businessId, locationId, key])
  @@index([businessId, key])
  @@map("number_sequences")
}
